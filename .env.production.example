# ==============================================
# 生产环境配置模板
# 复制此文件为 .env.production 并修改配置
# ==============================================

# 数据库配置
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=social_media
DB_PORT=5432

# Redis配置
REDIS_PORT=6379

# 安全配置 (必须修改!)
SECRET_KEY=your_very_long_secret_key_at_least_32_characters_long_change_me

# 调试模式 (生产环境必须为false)
DEBUG=false

# Twitter OAuth配置
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=https://your-domain.com/api/v1/auth/twitter/callback

# 代理配置 (可选)
PROXY_HTTP=
PROXY_HTTPS=

# Telegram配置
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# CORS配置 (允许的前端域名)
CORS_ORIGINS=["https://your-domain.com"]

# 前端端口
FRONTEND_PORT=80

# 后端实例数量
BACKEND_REPLICAS=2

# Celery并发数
CELERY_CONCURRENCY=4

# 版本标签
VERSION=1.0.0

# 初始管理员账户 (首次部署时使用)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_immediately
ADMIN_EMAIL=admin@your-domain.com

# 备份配置
BACKUP_DIR=/var/backups/social_media
RETENTION_DAYS=30
